# Terraform local directories and state files
**/.terraform/*
*.tfstate
*.tfstate.*
*.tflock
*tfplan*
crash.log
crash.*.log

# Sensitive variable files (keep examples tracked)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Credentials, secrets, and local exports
.env
.env.*
*.pem
*.key
*.csv

# OS and IDE noise
.DS_Store
Thumbs.db
.vscode/
.idea/
